# source - publish compiled dist/ only
src/
tsconfig.json

# git / editor meta (npm already ignores .git, node_modules)
.gitignore
.vscode/
.idea/

# tests / examples (keep tarball small)
tests/
__tests__/
*.test.ts
*.test.js
*.spec.ts
*.spec.js
examples/
coverage/
.nyc_output/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env / OS
.env
.env.local
.DS_Store
Thumbs.db

# NOTE: dist/ is intentionally NOT ignored here so it gets published.
# It IS ignored in .gitignore and should be built before publish (`npm run build`).
